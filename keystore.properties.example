# Copy to keystore.properties (gitignored) to sign a release build.
# Create the keystore once:
#   keytool -genkeypair -keystore upload-keystore.jks -alias waterplane-game -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the repository root.
storeFile=upload-keystore.jks
storePassword=
keyAlias=waterplane-game
keyPassword=
